      <Item class="ModuleScript" referent="RBX10">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">return {
 MapSize = 1536, Seed = 7319, MaxHealth = 100,
 WalkSpeed = 12, SprintSpeed = 21, CrouchSpeed = 7,
 Weapons = {
  M416 = {Damage=25, HeadMultiplier=2, Interval=0.1, Magazine=30, Reload=2.4, Speed=1800, Gravity=38, Range=2200, Spread=0.003, Recoil=1.1},
  AKM = {Damage=33, HeadMultiplier=2, Interval=0.14, Magazine=30, Reload=2.8, Speed=1500, Gravity=38, Range=2000, Spread=0.004, Recoil=1.7},
 },
}
</ProtectedString>
